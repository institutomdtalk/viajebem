<!doctype html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="theme-color" content="#050b16">
<title>Viaje Bem · English for Travelers</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,wght@0,400;0,500;1,400&family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&family=DM+Mono:wght@400;500&family=DM+Sans:wght@400;500;600;700&family=Instrument+Serif:ital@0;1&family=Manrope:wght@400;500;600;700;800&family=Nunito+Sans:ital,wght@0,400;0,600;0,700;1,400&family=Playfair+Display:ital,wght@0,400;0,500;0,600;1,400;1,600&family=Plus+Jakarta+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&display=swap" rel="stylesheet">
<style id="routeStyles"></style>
<style id="shellStyles">
html,body{margin:0;min-height:100%;background:#050b16}
#vbViewport{min-height:100vh}
#vbSiteMenuButton{position:fixed;right:18px;bottom:18px;z-index:100000;width:50px;height:50px;border-radius:50%;border:1px solid rgba(116,215,255,.25);background:rgba(5,13,25,.92);backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);color:#dff5ff;cursor:pointer;box-shadow:0 12px 34px rgba(0,0,0,.34),0 0 24px rgba(116,215,255,.06);display:none;place-items:center;font:700 17px/1 Arial;transition:.2s}
#vbSiteMenuButton:hover{transform:translateY(-2px);border-color:rgba(116,215,255,.48)}
#vbSiteMenu{position:fixed;right:18px;bottom:78px;z-index:100001;width:min(350px,calc(100vw - 36px));max-height:min(72vh,720px);overflow:auto;padding:10px;border:1px solid rgba(145,190,231,.16);border-radius:18px;background:rgba(5,13,25,.97);backdrop-filter:blur(18px);-webkit-backdrop-filter:blur(18px);box-shadow:0 22px 70px rgba(0,0,0,.44);display:none;font-family:Arial,sans-serif}
#vbSiteMenu.open{display:block}.vb-menu-head{padding:10px 11px 13px;border-bottom:1px solid rgba(255,255,255,.07);margin-bottom:7px}.vb-menu-head b{display:block;color:#eef8ff;font:700 13px/1.2 Arial}.vb-menu-head span{display:block;margin-top:5px;color:#6f869e;font:600 8px/1.2 monospace;letter-spacing:.13em;text-transform:uppercase}
.vb-menu-item{width:100%;display:flex;align-items:center;gap:11px;border:0;background:transparent;color:#adbdcc;border-radius:12px;padding:10px 12px;text-align:left;cursor:pointer;font:700 11px/1.25 Arial}.vb-menu-item:hover,.vb-menu-item.active{background:rgba(116,215,255,.07);color:#ecf9ff}.vb-menu-item code{width:32px;color:#76cef4;font:700 9px/1 monospace}.vb-menu-item.logout{margin-top:6px;border-top:1px solid rgba(255,255,255,.06);border-radius:0;padding-top:14px;color:#c99f99}
#vbRouteToast{position:fixed;left:50%;bottom:24px;z-index:99999;transform:translate(-50%,18px);opacity:0;pointer-events:none;padding:9px 13px;border-radius:999px;border:1px solid rgba(116,215,255,.16);background:rgba(5,13,25,.9);backdrop-filter:blur(12px);color:#b9d8e8;font:600 9px/1 monospace;letter-spacing:.08em;transition:.25s}#vbRouteToast.show{opacity:1;transform:translate(-50%,0)}
@media(max-width:600px){#vbSiteMenuButton{right:12px;bottom:12px}#vbSiteMenu{right:12px;bottom:68px;width:calc(100vw - 24px);max-height:75vh}}
</style>
</head>
<body>
<div id="vbViewport"></div>
<button id="vbSiteMenuButton" type="button" aria-label="Abrir menu do site">☰</button>
<div id="vbSiteMenu" role="menu"><div class="vb-menu-head"><b>Viaje Bem</b><span>Travel Quest · um único site</span></div><button class="vb-menu-item" data-page="home"><code>⌂</code>Home / Dashboard</button><button class="vb-menu-item" data-page="onboarding"><code>00</code>Welcome / Onboarding</button><button class="vb-menu-item" data-page="first"><code>01</code>First Impressions</button><button class="vb-menu-item" data-page="airport"><code>02</code>Airport, Flight & Immigration</button><button class="vb-menu-item" data-page="hotel"><code>03</code>Accommodation & Hotel Stays</button><button class="vb-menu-item" data-page="move"><code>04</code>Getting Around</button><button class="vb-menu-item" data-page="dine"><code>05</code>Dining & Drinks</button><button class="vb-menu-item" data-page="shop"><code>06</code>Shopping Abroad</button><button class="vb-menu-item" data-page="care"><code>07</code>Pharmacy & Medical Emergencies</button><button class="vb-menu-item" data-page="wine"><code>B1</code>Wine English</button><button class="vb-menu-item" data-page="final"><code>B2</code>The Confident Traveler</button><button class="vb-menu-item logout" data-action="logout"><code>↩</code>Sair</button></div>
<div id="vbRouteToast"></div>
<script>
const VB_DATA={"login":"","home":"","onboarding":"","first":"","airport":"","hotel":"","move":"","dine":"","shop":"","care":"","wine":"","final":""};
const VB_TITLES={"home":"Home","onboarding":"Welcome / Onboarding","first":"First Impressions","airport":"Airport, Flight & Immigration","hotel":"Accommodation & Hotel Stays","move":"Getting Around","dine":"Dining & Drinks","shop":"Shopping Abroad","care":"Pharmacy & Medical Emergencies","wine":"Wine English","final":"The Confident Traveler"};
const VB_ROUTES=new Set(Object.keys(VB_DATA));
const viewport=document.getElementById('vbViewport');
const routeStyles=document.getElementById('routeStyles');
const menuButton=document.getElementById('vbSiteMenuButton');
const menu=document.getElementById('vbSiteMenu');
const toast=document.getElementById('vbRouteToast');
let vbAuthenticated=false,vbCurrent='login',vbRunId=0;
function vbDecode(key){const bin=atob(VB_DATA[key]);const bytes=Uint8Array.from(bin,c=>c.charCodeAt(0));return new TextDecoder().decode(bytes)}
function vbTitle(p){return VB_TITLES[p]||'Student Access'}
function vbToast(t){toast.textContent=t;toast.classList.add('show');clearTimeout(vbToast.t);vbToast.t=setTimeout(()=>toast.classList.remove('show'),900)}
function vbExtractStyles(doc){return [...doc.querySelectorAll('style')].map(s=>s.textContent||'').join('\n')}
function vbExecuteScripts(doc,runId){
  const scripts=[...doc.querySelectorAll('script')];
  for(const old of scripts){
    if(runId!==vbRunId)return;
    if(old.src)continue;
    const code=old.textContent||'';
    if(!code.trim())continue;
    try{(new Function(code))()}catch(err){console.error('Viaje Bem page script error:',vbCurrent,err)}
  }
}
function vbRender(page,push=true){
  if(page!=='login'&&!vbAuthenticated)page='login';
  if(!VB_DATA[page])return;
  vbCurrent=page; vbRunId++; const runId=vbRunId;
  const parsed=new DOMParser().parseFromString(vbDecode(page),'text/html');
  routeStyles.textContent=vbExtractStyles(parsed);
  document.body.className=''; document.body.removeAttribute('style'); document.documentElement.removeAttribute('style');
  const bodyClone=parsed.body.cloneNode(true); bodyClone.querySelectorAll('script').forEach(s=>s.remove());
  viewport.replaceChildren(...bodyClone.childNodes);
  const logged=page!=='login';
  menuButton.style.display=logged?'grid':'none';
  if(!logged)menu.classList.remove('open');
  document.querySelectorAll('.vb-menu-item[data-page]').forEach(b=>b.classList.toggle('active',b.dataset.page===page));
  document.title='Viaje Bem · '+vbTitle(page);
  if(push){try{history.replaceState(null,'','#'+page)}catch(e){}}
  window.scrollTo({top:0,left:0,behavior:'auto'});
  setTimeout(()=>{if(runId===vbRunId)vbExecuteScripts(parsed,runId)},0);
  if(logged)vbToast(vbTitle(page));
}
window.vbLoginSuccess=function(){vbAuthenticated=true;vbRender('home')};
function vbLogout(){vbAuthenticated=false;try{localStorage.removeItem('viajebem-prototype-session')}catch(e){}vbRender('login')}
window.vbNavigate=vbRender;
menuButton.addEventListener('click',()=>menu.classList.toggle('open'));
menu.addEventListener('click',e=>{const b=e.target.closest('button');if(!b)return;if(b.dataset.page){menu.classList.remove('open');vbRender(b.dataset.page)}else if(b.dataset.action==='logout'){menu.classList.remove('open');vbLogout()}});
// One-link router: every module-to-module action stays inside this single HTML.
document.addEventListener('click',e=>{
  const a=e.target.closest&&e.target.closest('a');
  if(a){
    const route=a.dataset.vbRoute || ((a.getAttribute('href')||'').match(/^#(home|onboarding|first|airport|hotel|move|dine|shop|care|wine|final)$/)||[])[1];
    if(route&&VB_ROUTES.has(route)&&vbAuthenticated){e.preventDefault();e.stopImmediatePropagation();vbRender(route);return}
    const href=(a.getAttribute('href')||'').trim();
    if(/^#s\d+$/.test(href)){const target=document.querySelector(href);if(target){e.preventDefault();target.scrollIntoView({behavior:'smooth',block:'start'});return}}
  }
  if(!menu.contains(e.target)&&e.target!==menuButton)menu.classList.remove('open');
},true);
window.addEventListener('hashchange',()=>{const r=(location.hash||'').slice(1);if(VB_ROUTES.has(r)&&r!==vbCurrent)vbRender(r,false)});
try{vbAuthenticated=localStorage.getItem('viajebem-prototype-session')==='1'}catch(e){}
let initial=(location.hash||'').replace('#','');
if(!vbAuthenticated||!VB_ROUTES.has(initial)||initial==='login'&&vbAuthenticated)initial=vbAuthenticated?'home':'login';
vbRender(initial,false);
</script>
</body>
</html>
